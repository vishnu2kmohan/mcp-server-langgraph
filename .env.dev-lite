# Dev-Lite Environment Configuration
# ==================================
# Copy this to .env when using docker/docker-compose.dev-lite.yml
# This configuration uses minimal resources (~512MB RAM)

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Authentication - Use in-memory provider (no Keycloak)
AUTH_PROVIDER=inmemory
JWT_SECRET_KEY=dev-lite-jwt-secret-key-not-for-production

# Authorization - Mock mode (no OpenFGA)
ENABLE_MOCK_AUTHORIZATION=true
ALLOW_AUTH_FALLBACK=true

# Database (PostgreSQL from dev-lite compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gdpr

# Redis (from dev-lite compose)
REDIS_URL=redis://localhost:6379
CHECKPOINT_BACKEND=redis
CHECKPOINT_REDIS_URL=redis://localhost:6379

# Observability - Console only (no LGTM stack)
OBSERVABILITY_BACKEND=console
ENABLE_CONSOLE_EXPORT=true
ENABLE_TRACING=false
ENABLE_METRICS=false
LANGSMITH_TRACING=false

# Disable dynamic context loading (no Qdrant)
ENABLE_DYNAMIC_CONTEXT_LOADING=false

# LLM Configuration (set your API key)
LLM_PROVIDER=google
# GOOGLE_API_KEY=your-api-key-here

# Feature Flags - Simplified for development
ENABLE_CONTEXT_COMPACTION=true
ENABLE_VERIFICATION=false
ENABLE_PARALLEL_EXECUTION=false
