# Builder frontend gitignore
# Overrides root .gitignore for this directory

# Keep package-lock.json tracked (required for npm ci in Docker builds)
!package-lock.json

# Ignore build artifacts and dependencies
node_modules/
dist/
coverage/
*.log

*storybook.log
storybook-static

# Shard test logs (preserved for post-mortem analysis of failed runs)
.vitest-shard-logs/

# Heap snapshots (security-sensitive, may contain in-memory secrets)
*.heapsnapshot
