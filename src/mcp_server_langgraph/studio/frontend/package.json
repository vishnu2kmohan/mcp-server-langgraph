{
  "name": "@mcp-server-langgraph/studio-frontend",
  "version": "2.9.0-dev",
  "type": "module",
  "description": "Unified Studio Frontend for MCP Server LangGraph - Consolidates Builder and Playground",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest",
    "test:run": "bash scripts/run-tests-sharded.sh",
    "test:parallel": "bash scripts/run-tests-sharded.sh --parallel",
    "test:quick": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest run --shard=1/50",
    "test:ui": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest --ui",
    "test:coverage": "bash scripts/run-tests-sharded.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:with-backend": "cross-env BACKEND_ENABLED=true playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "test:a11y": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest run --testNamePattern='Accessibility|WCAG|axe|a11y' --reporter=json --outputFile=a11y-report/summary.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "generate-types": "openapi-typescript ../../../../api/openapi.json -o src/types/generated-api.ts",
    "generate-types:check": "openapi-typescript ../../../../api/openapi.json --dry-run",
    "validate:test-cleanup": "tsx scripts/validate-test-cleanup.ts",
    "check:design-system": "tsx scripts/check-design-system-compliance.ts",
    "check:design-system:strict": "tsx scripts/check-design-system-compliance.ts --strict",
    "check:design-system:violations": "tsx scripts/check-design-system-compliance.ts --violations",
    "fix:nav-buttons": "tsx scripts/fix-navigation-button-variants.ts",
    "fix:nav-buttons:dry-run": "tsx scripts/fix-navigation-button-variants.ts --dry-run --verbose",
    "audit:design-system": "tsx scripts/audit-design-system.ts",
    "audit:design-system:json": "tsx scripts/audit-design-system.ts --json",
    "audit:design-system:strict": "tsx scripts/audit-design-system.ts --strict",
    "audit:design-system:fix": "tsx scripts/audit-design-system.ts --fix --verbose",
    "audit:design-system:auto-fix": "tsx scripts/audit-design-system.ts --auto-fix",
    "audit:design-system:auto-fix:dry": "tsx scripts/audit-design-system.ts --auto-fix --dry-run",
    "check:unused": "knip",
    "check:unused:json": "knip --reporter json",
    "test:design-system-contract": "NODE_OPTIONS='--max-old-space-size=8192' vitest run src/design-system/design-system-contract.test.ts",
    "migrate:buttons": "npx jscodeshift --parser=tsx --extensions=tsx -t scripts/codemods/migrate-buttons.ts",
    "migrate:inputs": "npx jscodeshift --parser=tsx --extensions=tsx -t scripts/codemods/migrate-inputs.ts",
    "fix:button-variants": "npx jscodeshift --parser=tsx --extensions=tsx -t scripts/codemods/fix-button-semantics.ts",
    "fix:button-variants:dry": "npx jscodeshift --dry --parser=tsx --extensions=tsx -t scripts/codemods/fix-button-semantics.ts",
    "migrate:all": "./scripts/migrate-to-design-system.sh --all",
    "migrate:check": "./scripts/migrate-to-design-system.sh --check",
    "migrate:colors": "python3 scripts/migrate-raw-colors.py",
    "migrate:colors:dry": "python3 scripts/migrate-raw-colors.py --dry-run -v",
    "test:sharded": "bash scripts/run-tests-sharded.sh",
    "test:shard": "VITEST_MAX_FORKS=1 NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' vitest run",
    "test:single": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest run",
    "test:ci": "VITEST_HEAP_SIZE=4096 VITEST_MAX_FORKS=1 NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/colors": "^3.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.2",
    "motion": "^12.26.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-player": "^3.4.0",
    "react-redux": "^9.1.2",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^7.11.0",
    "react-syntax-highlighter": "^16.1.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^1.7.1",
    "unist-util-visit": "^5.0.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-themes": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^10.1.11",
    "jest-axe": "^10.0.0",
    "jscodeshift": "^17.3.0",
    "knip": "^5.0.0",
    "jsdom": "^27.3.0",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.10.1",
    "playwright": "^1.57.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "storybook": "^10.1.11",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16",
    "workbox-window": "^7.4.0"
  }
}
