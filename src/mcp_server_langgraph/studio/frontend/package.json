{
  "name": "@mcp-server-langgraph/studio-frontend",
  "version": "2.9.0-dev",
  "type": "module",
  "description": "Unified Studio Frontend for MCP Server LangGraph - Consolidates Builder and Playground",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:with-backend": "cross-env BACKEND_ENABLED=true playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "generate-types": "openapi-typescript ../../../../api/openapi.json -o src/types/generated-api.ts",
    "generate-types:check": "openapi-typescript ../../../../api/openapi.json --dry-run"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.6.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-player": "^3.4.0",
    "react-redux": "^9.1.2",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^7.10.1",
    "react-syntax-highlighter": "^16.1.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.5.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.49.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8",
    "workbox-window": "^7.4.0"
  }
}
