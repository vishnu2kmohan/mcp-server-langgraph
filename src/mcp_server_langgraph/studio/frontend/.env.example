# Agent Studio Frontend Environment Variables
#
# Copy this file to .env.local for local development.
# All variables are optional with sensible defaults for development.
#
# Reference: 12-Factor App Principle III - Store config in environment
# Documentation: src/config/api.ts

# =============================================================================
# API Configuration
# =============================================================================

# API Base URL for REST endpoints
# Default: /api/v1 (relative URL for same-origin deployments)
# Production: https://api.your-domain.com/v1
# VITE_API_BASE_URL=/api/v1

# WebSocket Base URL for real-time connections
# Default: Derived from window.location (wss:// for https://, ws:// for http://)
# Production: wss://ws.your-domain.com/v1
# VITE_WS_BASE_URL=wss://ws.your-domain.com/api/v1

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable interactive artifacts feature
# Default: false
# VITE_ENABLE_INTERACTIVE_ARTIFACTS=true

# Enable real-time AI suggestions
# Default: false
# VITE_ENABLE_AI_SUGGESTIONS=true

# =============================================================================
# Observability Polling (Optional)
# =============================================================================

# Polling intervals in milliseconds. Set to 0 to disable.
# These are mapped to frontend build-time settings; no VITE_ prefix required.
# Defaults: trace list active=5000, idle=20000, trace detail=5000,
# metrics=15000, logs=15000, alerts=10000
# OBSERVABILITY_TRACE_LIST_POLLING_ACTIVE_MS=5000
# OBSERVABILITY_TRACE_LIST_POLLING_IDLE_MS=20000
# OBSERVABILITY_TRACE_DETAIL_POLLING_MS=5000
# OBSERVABILITY_METRICS_POLLING_MS=15000
# OBSERVABILITY_LOGS_POLLING_MS=15000
# OBSERVABILITY_ALERTS_POLLING_MS=10000

# =============================================================================
# Development / Debugging
# =============================================================================

# Enable verbose logging in development
# Default: false
# VITE_DEBUG=true

# Test API URL for unit tests (Node.js fetch requires absolute URLs)
# Used by vitest when running tests
# TEST_API_URL=http://127.0.0.1:3000/api/v1

# =============================================================================
# Authentication (if not using Keycloak SSO)
# =============================================================================

# Keycloak realm URL (for OIDC discovery)
# VITE_KEYCLOAK_URL=https://auth.your-domain.com/realms/your-realm

# OIDC client ID
# VITE_OIDC_CLIENT_ID=agent-studio
