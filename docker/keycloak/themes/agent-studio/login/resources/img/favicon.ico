<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <!--
    Agent Studio Favicon
    Simplified version of icon.svg optimized for small sizes (16x16, 32x32).
    Design System: primary.500 (#3b82f6) to primary.700 (#1d4ed8) gradient
  -->
  <defs>
    <linearGradient id="favicon-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1d4ed8;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background circle with gradient -->
  <circle cx="16" cy="16" r="15" fill="url(#favicon-gradient)" />

  <!-- Simplified agent/graph icon for small sizes -->
  <g fill="white">
    <!-- Central node (top) -->
    <circle cx="16" cy="10" r="3.5" opacity="0.95"/>
    <!-- Left node (bottom-left) -->
    <circle cx="9" cy="21" r="2.8" opacity="0.85"/>
    <!-- Right node (bottom-right) -->
    <circle cx="23" cy="21" r="2.8" opacity="0.85"/>
    <!-- Connection lines -->
    <line x1="16" y1="13.5" x2="11" y2="18.5" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
    <line x1="16" y1="13.5" x2="21" y2="18.5" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
    <line x1="11.5" y1="21" x2="20.5" y2="21" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
  </g>
</svg>
