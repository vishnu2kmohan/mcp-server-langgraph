# OpenFGA Playground Auth Proxy Dockerfile
# =========================================
# Protects OpenFGA Playground with Keycloak + OpenFGA authorization
#
# Features:
# - Keycloak JWT validation
# - OpenFGA permission checking (admin on authz:playground)
# - Request proxying to OpenFGA Playground
#
# OPTIMIZATION (80% size reduction: 1.4GB → ~300MB):
# - Uses uv dependency group [dependency-groups.authz-proxy] from pyproject.toml
# - Installs ONLY authz-proxy runtime deps, not full project (LangGraph, LLM providers)
# - Multi-stage build removes uv from runtime image
#
# Reference: ADR-0068 - Gateway-Level Authentication

ARG PYTHON_VERSION=3.12

# ==============================================================================
# STAGE: builder
# Install only the authz-proxy dependency group (not full project deps)
# ==============================================================================
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /app

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Enable bytecode compilation for faster startup
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Copy only pyproject.toml and uv.lock (for dependency resolution)
COPY pyproject.toml uv.lock ./

# Install ONLY the authz-proxy dependency group
# --no-install-project: Don't install the main project (which would pull in all deps)
# --only-group authz-proxy: Install only the minimal authz-proxy dependencies
# This reduces image size from 1.4GB to ~300MB
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --only-group authz-proxy

# Copy only the packages required by authz-proxy (not entire src/)
# Dependencies traced from: authz_proxy/server.py imports + transitive deps
COPY src/mcp_server_langgraph/__init__.py ./src/mcp_server_langgraph/
COPY src/mcp_server_langgraph/authz_proxy/ ./src/mcp_server_langgraph/authz_proxy/
COPY src/mcp_server_langgraph/auth/ ./src/mcp_server_langgraph/auth/
COPY src/mcp_server_langgraph/core/ ./src/mcp_server_langgraph/core/
COPY src/mcp_server_langgraph/observability/ ./src/mcp_server_langgraph/observability/
COPY src/mcp_server_langgraph/resilience/ ./src/mcp_server_langgraph/resilience/
COPY src/mcp_server_langgraph/secret_providers/ ./src/mcp_server_langgraph/secret_providers/
COPY src/mcp_server_langgraph/middleware/ ./src/mcp_server_langgraph/middleware/
# Note: llm/, utils/, repositories/, storage/, models/, database/ NOT copied
# Note: config/ is NOT needed at runtime (model.json only used by openfga-seed)

# ==============================================================================
# STAGE: runtime
# Minimal runtime image without uv or build tools
# ==============================================================================
FROM python:${PYTHON_VERSION}-slim AS runtime

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv
# Copy source for editable install (uv sync creates pth file pointing to /app/src)
COPY --from=builder /app/src /app/src
# Copy uvicorn log config for JSON-structured logging (LGTM stack integration)
COPY docker/uvicorn-log-config.yaml /app/uvicorn-log-config.yaml

# Set PATH to use virtual environment
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src:$PYTHONPATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Expose authz-proxy port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8003/api/authz-proxy/health || exit 1

# Run the authz-proxy server with JSON logging for LGTM stack
CMD ["uvicorn", "mcp_server_langgraph.authz_proxy.server:app", "--host", "0.0.0.0", "--port", "8003", "--log-config", "/app/uvicorn-log-config.yaml"]
