# OpenFGA Playground Auth Proxy Dockerfile
# =========================================
# Protects OpenFGA Playground with Keycloak + OpenFGA authorization
#
# Features:
# - Keycloak JWT validation
# - OpenFGA permission checking (admin on authz:playground)
# - Request proxying to OpenFGA Playground
#
# Reference: ADR-0068 - Gateway-Level Authentication

# Build stage: Install dependencies
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Enable bytecode compilation for faster startup
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Install dependencies (using frozen lockfile for reproducibility)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# Copy only the packages required by authz-proxy (not entire src/)
# This enables Docker build caching - unrelated changes (frontend, MCP, API) won't trigger rebuilds
# Dependencies traced from: authz_proxy/server.py imports + transitive deps
COPY src/mcp_server_langgraph/__init__.py ./src/mcp_server_langgraph/
COPY src/mcp_server_langgraph/authz_proxy/ ./src/mcp_server_langgraph/authz_proxy/
COPY src/mcp_server_langgraph/auth/ ./src/mcp_server_langgraph/auth/
COPY src/mcp_server_langgraph/core/ ./src/mcp_server_langgraph/core/
COPY src/mcp_server_langgraph/observability/ ./src/mcp_server_langgraph/observability/
COPY src/mcp_server_langgraph/resilience/ ./src/mcp_server_langgraph/resilience/
COPY src/mcp_server_langgraph/secret_providers/ ./src/mcp_server_langgraph/secret_providers/
# Transitive deps from core/ module (core/agent.py, core/context_manager.py)
COPY src/mcp_server_langgraph/llm/ ./src/mcp_server_langgraph/llm/
COPY src/mcp_server_langgraph/utils/ ./src/mcp_server_langgraph/utils/
# Note: config/ is NOT needed at runtime (model.json only used by openfga-seed)

# Install project
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Runtime stage: Minimal image
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv
# Copy source for editable install (uv sync creates pth file pointing to /app/src)
# Note: Only authz-proxy dependencies are copied, not entire src/
COPY --from=builder /app/src /app/src

# Set PATH to use virtual environment
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Expose authz-proxy port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8003/api/authz-proxy/health || exit 1

# Run the authz-proxy server
CMD ["uvicorn", "mcp_server_langgraph.authz_proxy.server:app", "--host", "0.0.0.0", "--port", "8003"]
