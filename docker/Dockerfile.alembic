# syntax=docker/dockerfile:1.4
# Alembic Migration Dockerfile
# ============================
# Minimal multi-stage image for running database migrations (~50MB)
#
# This image is purpose-built for running Alembic migrations.
# It uses a lightweight approach - copying only the SQLAlchemy models file
# directly instead of installing the entire mcp_server_langgraph package.
#
# OPTIMIZATION:
#   - Uses uv dependency group [dependency-groups.alembic] from pyproject.toml
#   - Multi-stage build removes uv from runtime image (~52MB savings)
#   - Only copies models.py instead of full package (avoids 500MB+ of deps)
#   - Models are self-contained (only SQLAlchemy imports)
#
# USAGE:
#   docker build -f docker/Dockerfile.alembic -t alembic-migrate .
#   docker run -e POSTGRES_HOST=postgres alembic-migrate
#
# OPENSHIFT COMPATIBILITY:
#   - Uses numeric UID (1001) in USER directive
#   - Files owned by UID:0 (root group) for arbitrary UID support
#   - Group permissions set with g=u for OpenShift restricted-v2 SCC
#   - See: https://developers.redhat.com/articles/2021/11/11/best-practices-building-images-pass-red-hat-container-certification
#
# REFERENCES:
#   - https://docs.astral.sh/uv/guides/integration/docker/
#   - https://alembic.sqlalchemy.org/en/latest/

ARG PYTHON_VERSION=3.12

# ==============================================================================
# STAGE: builder
# Install dependencies using uv (fast), then discard uv in runtime
# ==============================================================================
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /app

# Install uv - Fast Python package manager (only used in build stage)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Enable bytecode compilation for faster startup
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Copy only pyproject.toml and uv.lock (for dependency resolution)
COPY pyproject.toml uv.lock ./

# Install ONLY the alembic dependency group (minimal: alembic, sqlalchemy, asyncpg, pyyaml)
# --no-install-project: Don't install the main project (which would pull in all deps)
# --only-group alembic: Install only the minimal migration dependencies
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-alembic,sharing=private \
    uv sync --frozen --no-install-project --only-group alembic

# ==============================================================================
# STAGE: runtime
# Minimal runtime image without uv (52MB savings)
# ==============================================================================
FROM python:${PYTHON_VERSION}-slim AS runtime

WORKDIR /app

# Create non-root user BEFORE copying files for efficient --chown
RUN useradd -u 1001 -g 0 -d /app -s /sbin/nologin appuser && \
    chown 1001:0 /app && chmod g=u /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy only the SQLAlchemy models file (self-contained, no heavy deps)
# This avoids installing the full mcp_server_langgraph package (500MB+ savings)
# alembic/env.py imports: from models import Base (local import)
COPY --chown=1001:0 src/mcp_server_langgraph/database/models.py ./models.py

# Copy only Alembic-related files with correct ownership
COPY --chown=1001:0 alembic.ini ./
COPY --chown=1001:0 alembic/ ./alembic/

# Set PATH to use virtual environment
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/app

# Drop privileges - use numeric UID for OpenShift compatibility
USER 1001

# OCI Image Labels
LABEL org.opencontainers.image.title="Alembic Migrations"
LABEL org.opencontainers.image.description="Image for PostgreSQL database migrations with autogenerate support"
LABEL org.opencontainers.image.vendor="MCP Server LangGraph"
LABEL io.openshift.tags="database,migrations,alembic,postgresql"
LABEL io.k8s.description="PostgreSQL database migrations using Alembic with SQLAlchemy model support"

# Default command runs all migrations
CMD ["alembic", "upgrade", "head"]

# No health check needed - this is a run-once container
HEALTHCHECK NONE
