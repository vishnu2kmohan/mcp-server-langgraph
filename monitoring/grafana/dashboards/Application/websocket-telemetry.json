      "pluginVersion": "10.0.0",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(websocket_active_connections)", "refId": "A" }],
      "title": "Active Connections",
      "type": "stat"
