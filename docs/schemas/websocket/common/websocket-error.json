          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "WebSocketErrorPayload",
      "type": "object"
    }
  },
  "description": "Error message (Server -> Client).",
  "properties": {
    "type": {
