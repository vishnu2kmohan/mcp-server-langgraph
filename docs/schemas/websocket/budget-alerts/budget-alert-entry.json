          "description": "Alert status"
        },
        "percent_used": {
          "description": "Percentage of budget used",
          "title": "Percent Used",
          "type": "number"
        },
        "current_spend": {
          "description": "Current spend amount",
          "title": "Current Spend",
          "type": "string"
        },
        "remaining": {
          "description": "Remaining budget",
          "title": "Remaining",
          "type": "string"
        },
        "monthly_limit_usd": {
          "description": "Monthly limit in USD",
          "title": "Monthly Limit Usd",
          "type": "string"
