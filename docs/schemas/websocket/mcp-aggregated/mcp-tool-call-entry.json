        "server_id",
        "tool_name"
      ],
      "title": "MCPToolCallPayload",
      "type": "object"
    }
  },
  "description": "MCP tool call update (Server -> Client).",
  "properties": {
    "type": {
      "const": "tool_call",
      "default": "tool_call",
      "title": "Type",
      "type": "string"
    },
    "payload": {
