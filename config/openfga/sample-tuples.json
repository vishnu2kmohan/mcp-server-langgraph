      "object": "role:premium"
    },
    {
      "user": "user:bob",
      "relation": "assignee",
      "object": "role:standard"
    },
    {
      "user": "user:admin",
      "relation": "assignee",
      "object": "role:premium"
    },
    {
      "_comment": "Vector Store permissions (ADR-0068)",
      "user": "user:admin",
      "relation": "owner",
      "object": "vector_store:default"
