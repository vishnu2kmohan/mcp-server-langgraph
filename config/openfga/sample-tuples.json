      "user": "user:alice",
      "relation": "owner",
      "object": "conversation:thread_1"
    },
    {
      "user": "user:bob",
      "relation": "viewer",
      "object": "conversation:thread_1"
    },
    {
      "user": "user:admin",
      "relation": "owner",
      "object": "conversation:thread_1"
    },
    {
