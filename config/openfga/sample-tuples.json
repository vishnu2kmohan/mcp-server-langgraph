{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "OpenFGA Relationship Tuples for Test Infrastructure (ADR-0068)",
  "metadata": {
    "purpose": "Single source of truth for test user permissions",
    "users": {
      "admin": "Super user with owner/admin access to all resources. Model inheritance (ADR-0068) ensures admin implicitly has 'user' and 'developer' relations via computed relations.",
      "alice": "Developer user with editor access to vectors (CRUD), viewer access to OpenFGA authz UI",
      "bob": "Basic user with viewer access to vectors (read-only, no OpenFGA authz UI access)"
    },
    "intentional_exclusions": {
      "authz:playground": "bob excluded - only admin/developer should access OpenFGA authorization UI",
      "identity:keycloak": "alice/bob excluded - Keycloak admin access is admin-only for security",
      "marketplace:admin": "alice/bob excluded - marketplace registration/management is admin-only (they have viewer for browsing)",
      "dashboard:alerts": "alice/bob excluded - infrastructure alerts are admin-only",
      "workflow:hitl": "bob excluded - only editors who can approve/reject HITL requests need 'editor' relation",
      "compliance:default": "bob excluded - compliance reports require security clearance (alice has viewer for compliance-officer sub-persona)",
      "skill:admin": "alice/bob excluded - skill system administration is admin-only (alice has author for install/update, bob has viewer)"
    },
    "model_inheritance_notes": {
      "ai_type": "admin → user → viewer (ADR-0068 fix for ai:suggestions bug)",
      "system_type": "admin → developer, admin → user, admin → viewer",
      "conversation_type": "owner → editor → viewer",
      "tool_index_type": "admin → viewer, organization member → viewer",
      "skill_type": "admin → author → viewer (alice can author skills, bob can view)",
      "marketplace_type": "admin → viewer (alice/bob can browse, only admin can register)",
      "memory_index_type": "owner → viewer, admin → viewer (user-scoped with admin override for privacy)"
    },
    "adr_references": ["ADR-0002 (OpenFGA Authorization)", "ADR-0068 (Gateway-Level Auth + OpenFGA Updates)", "ADR-0091 (API Response Transformation)", "ADR-0099 (Semantic Tool Selection)"],
    "updated": "2026-01-08"
  },
