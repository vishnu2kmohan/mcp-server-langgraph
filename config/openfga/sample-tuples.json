{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "OpenFGA Relationship Tuples for Test Infrastructure (ADR-0068)",
  "metadata": {
    "purpose": "Single source of truth for test user permissions",
    "users": {
      "admin": "Super user with owner/admin access to all resources. Has both 'admin' and 'user' relations where WebSocket endpoints require 'user' relation (ADR-0091 fix)",
      "alice": "Developer user with editor access to vectors (CRUD), viewer access to OpenFGA authz UI",
      "bob": "Basic user with viewer access to vectors (read-only, no OpenFGA authz UI access)"
    },
    "intentional_exclusions": {
      "authz:playground": "bob excluded - only admin/developer should access OpenFGA authorization UI",
      "identity:keycloak": "alice/bob excluded - Keycloak admin access is admin-only for security",
      "marketplace:default": "alice/bob excluded - marketplace management is admin-only",
      "dashboard:alerts": "alice/bob excluded - infrastructure alerts are admin-only",
      "workflow:hitl": "bob excluded - only editors who can approve/reject HITL requests need 'editor' relation",
      "compliance:default": "bob excluded - compliance reports require security clearance (alice has viewer for compliance-officer sub-persona)"
    },
    "adr_references": ["ADR-0068 (OpenFGA ReBAC)", "ADR-0091 (API Response Transformation - admin user relation fix)"],
    "updated": "2026-01-04"
  },
