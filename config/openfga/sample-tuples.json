    {
      "_comment": "OpenFGA Playground (authz) permissions (ADR-0068) - bob intentionally excluded",
      "user": "user:admin",
      "relation": "admin",
      "object": "authz:playground"
    },
    {
      "user": "user:alice",
      "relation": "viewer",
      "object": "authz:playground"
    }
