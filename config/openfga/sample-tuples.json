{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "OpenFGA Relationship Tuples for Test Infrastructure (ADR-0068)",
  "metadata": {
    "purpose": "Single source of truth for test user permissions",
    "users": {
      "admin": "Super user with owner/admin access to all resources",
      "alice": "Standard user with viewer access (org admin)",
      "bob": "Basic user with viewer access (no playground access)"
    },
    "updated": "2025-12-13"
  },
  "tuples": [
