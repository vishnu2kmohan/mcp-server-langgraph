        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(pagination_requests_total{type=\"offset\"}[24h]))", "legendFormat": "Offset (Deprecated)", "refId": "B" }
      ],
      "title": "Pagination Type Usage (24h)",
      "type": "piechart"
    }
