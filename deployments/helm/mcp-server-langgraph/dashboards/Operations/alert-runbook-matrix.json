{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Alert-Runbook Correlation Matrix - Links alerts with troubleshooting runbooks for incident response",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Runbook Index",
      "tooltip": "Runbook Documentation",
      "type": "link",
      "url": "https://github.com/vishnu2kmohan/mcp-server-langgraph/tree/main/monitoring/runbooks"
    },
    {
      "asDropdown": false,
      "icon": "bolt",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Alert Rules",
      "tooltip": "Grafana Alert Rules",
      "type": "link",
