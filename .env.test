# =============================================================================
# Test Environment Configuration
# =============================================================================
# This file contains test environment defaults for `make test-infra-up`.
# It is checked into git and provides the source of truth for test config.
#
# Override locally with:
#   - .env.test.local (gitignored, personal overrides)
#   - Shell environment variables
#
# Docker networking values (container hostnames like redis-test, postgres-test)
# are set in docker-compose.test.yml environment: block as they require
# compose-level interpolation.
#
# 12-Factor Compliance:
#   - Config separated from code ✓
#   - Environment variables ✓
#   - No production secrets ✓ (test-only credentials)
#
# Synchronization:
#   Values here MUST match:
#   - docker-compose.test.yml environment: block
#   - tests/constants.py
#   - .github/workflows/e2e-tests.yaml env: section
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=test
TESTING=true
# LOG_LEVEL=INFO  # Uses default

# -----------------------------------------------------------------------------
# JWT Authentication (test-only secret, safe to commit)
# -----------------------------------------------------------------------------
# IMPORTANT: This MUST match docker-compose.test.yml and tests/constants.py
JWT_SECRET_KEY=agent-studio-jwt-secret-key-for-e2e-tests

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis databases (all on localhost:9379, mapped from redis-test:6379)
# DB Allocation:
#   - DB 0: User sessions (AuthMiddleware, 24h TTL)
#   - DB 1: LangGraph conversation checkpoints (7-day TTL)
#   - DB 2: L2 distributed cache (CacheService)
#   - DB 3: API key lookup cache (indexed, 1h TTL)
REDIS_HOST=localhost
REDIS_PORT=9379
REDIS_URL=redis://localhost:9379/0
REDIS_SESSION_URL=redis://localhost:9379/0
CHECKPOINT_REDIS_URL=redis://localhost:9379/1
REDIS_CACHE_URL=redis://localhost:9379/2

# -----------------------------------------------------------------------------
# Conversation Checkpointing (Agent Memory)
# -----------------------------------------------------------------------------
# Enable Redis-backed checkpointing for conversation persistence
CHECKPOINT_BACKEND=redis
CHECKPOINT_REDIS_TTL=604800

# -----------------------------------------------------------------------------
# Database (test credentials, safe to commit)
# -----------------------------------------------------------------------------
# PostgreSQL connection - host set in docker-compose.test.yml (postgres-test)
POSTGRES_PORT=5432
POSTGRES_DB=agent_studio_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://localhost:5432/agent_studio_test

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Use Keycloak for unified AuthN (users seeded via realm import)
AUTH_PROVIDER=keycloak
KEYCLOAK_REALM=default
KEYCLOAK_CLIENT_ID=agent-studio-keycloak-client-id-for-e2e-tests
KEYCLOAK_CLIENT_SECRET=test-client-secret-for-e2e-tests
# Admin API access (must use master realm for admin-cli client)
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Frontend URL for OAuth2 callback redirects
# In Docker/Traefik environments, use gateway URL (http://localhost)
# In local development, use Vite dev server (http://localhost:5173)
FRONTEND_URL=http://localhost

# -----------------------------------------------------------------------------
# OAuth2 (MCP Connections)
# -----------------------------------------------------------------------------
# Redirect URI for OAuth2-authenticated MCP server connections
# Must match Keycloak client redirectUris in tests/e2e/default-realm.json
OAUTH2_REDIRECT_URI=http://localhost/studio/oauth/callback

# -----------------------------------------------------------------------------
# LLM Provider - Vertex AI (GCP Project: vishnu-sandbox-20250310)
# -----------------------------------------------------------------------------
# Uses Vertex AI for Gemini and Claude models
# Authentication: gcloud auth application-default login (or service account)
#
# GLOBAL ENDPOINT (GA - Generally Available):
# Both Claude and Gemini models now support the global endpoint on Vertex AI.
# The global endpoint dynamically routes requests to regions with available capacity.
# See: https://cloud.google.com/blog/products/ai-machine-learning/global-endpoint-for-claude-models-generally-available-on-vertex-ai
#
# Supported Claude models for global: Opus 4, Sonnet 4, Sonnet 3.7, Sonnet 3.5 v2
# Gemini models also support global endpoint.
#
LLM_PROVIDER=vertex_ai
# Claude Sonnet 4.5 via Vertex AI (global endpoint supported)
#MODEL_NAME=vertex_ai/claude-sonnet-4-5@20250929
# Alternative models (all support global endpoint):
#MODEL_NAME=vertex_ai/claude-opus-4-5@20251101
#MODEL_NAME=vertex_ai/claude-haiku-4-5@20251001
MODEL_NAME=vertex_ai/gemini-3-flash-preview
#MODEL_NAME=vertex_ai/gemini-3-pro-preview
#MODEL_NAME=vertex_ai/gemini-2.5-flash
#
# Fallback Models (Vertex AI only - no OpenAI dependency in test env)
# Uses Vertex AI models for cross-model resilience (Gemini + Claude)
ENABLE_FALLBACK=true
FALLBACK_MODELS=["vertex_ai/gemini-2.5-flash","vertex_ai/claude-sonnet-4-5@20250929"]
#
# Global endpoint - works for both Claude and Gemini models
VERTEXAI_LOCATION=global
GOOGLE_CLOUD_LOCATION=global
GOOGLE_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
#
# Specialized model names for specific tasks
SUMMARIZATION_MODEL_NAME=vertex_ai/gemini-3-flash-preview
VERIFICATION_MODEL_NAME=vertex_ai/gemini-3-flash-preview

# -----------------------------------------------------------------------------
# Code Execution Backend
# -----------------------------------------------------------------------------
CODE_EXECUTION_BACKEND=docker-engine
# NOTE: These Settings values are kept for backwards compatibility.
# Prefer FF_CODE_EXECUTION_ENABLED and FF_SANDBOX_TOOLS_ENABLED for new code.
ENABLE_CODE_EXECUTION=true
ENABLE_SANDBOX_TOOLS=true

# -----------------------------------------------------------------------------
# Cost Metrics Storage (Phase 2.2 SRP decomposition)
# -----------------------------------------------------------------------------
# Uses PostgresCostStorage for cost tracking persistence
COST_STORAGE_BACKEND=postgres

# -----------------------------------------------------------------------------
# Workflow Storage (Unified Workspace Paradigm)
# -----------------------------------------------------------------------------
# Uses PostgresWorkflowManager for workflow definitions and sharing
WORKFLOW_STORAGE_BACKEND=postgres

# -----------------------------------------------------------------------------
# Session Storage
# -----------------------------------------------------------------------------
# Backend for session state persistence
SESSION_BACKEND=redis

# -----------------------------------------------------------------------------
# Conversation Storage
# -----------------------------------------------------------------------------
# Backend for conversation history persistence (database or redis)
CONVERSATION_STORAGE_BACKEND=database

# -----------------------------------------------------------------------------
# Artifacts Storage
# -----------------------------------------------------------------------------
# Backend for artifact persistence (code, documents, etc.)
ARTIFACTS_STORAGE_BACKEND=postgres

# -----------------------------------------------------------------------------
# Vector Database (Qdrant)
# -----------------------------------------------------------------------------
# Qdrant URL for vector storage - host set in docker-compose.test.yml (qdrant-test)
# Default port matches docker-compose.test.yml mapped port (9333:6333)
QDRANT_URL=http://localhost:9333
QDRANT_COLLECTION_NAME=agent_studio_test
QDRANT_VECTOR_SIZE=768

# -----------------------------------------------------------------------------
# Dynamic Context Loading (Knowledge Base)
# -----------------------------------------------------------------------------
# Enable dynamic context loading for Knowledge Base functionality
# When true, KB status will show "ready" instead of "misconfigured"
ENABLE_DYNAMIC_CONTEXT_LOADING=true

# -----------------------------------------------------------------------------
# Embedding Configuration (for Semantic Search)
# -----------------------------------------------------------------------------
# Uses Settings defaults: google_vertex, text-embedding-005, 768 dimensions

# -----------------------------------------------------------------------------
# Vector Search Provider Configuration
# -----------------------------------------------------------------------------
# Provider for semantic plan search and template matching
# Options: "inmemory" (default, testing), "pgvector" (PostgreSQL), "qdrant"
# Use "qdrant" in test environment for full-featured vector search
VECTOR_SEARCH_PROVIDER=qdrant

# -----------------------------------------------------------------------------
# Compliance Storage (GDPR, HIPAA, SOC2, FedRAMP)
# -----------------------------------------------------------------------------
# Multi-framework compliance storage for user profiles, consents, and audit logs
# Backend: "postgres" (production), "memory" (dev/test only)
COMPLIANCE_STORAGE_BACKEND=postgres

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OBSERVABILITY_BACKEND=opentelemetry
OTEL_SDK_DISABLED=false
ENABLE_TRACING=true
ENABLE_METRICS=true
SERVICE_NAME=agent-studio-test
OTEL_SERVICE_NAME=agent-studio-test
# Disable console span/metric export to reduce log noise (send to OTLP only)
# Spans are sent to Alloy via OTEL_EXPORTER_OTLP_ENDPOINT, not stdout
ENABLE_CONSOLE_EXPORT=false

# QUIET_LOGS mode reduces log verbosity:
# - Sets console handler to WARNING level (overrides LOG_LEVEL)
# - Filters health check endpoints (/health, /healthz, /health/live, /health/ready, etc.)
# - Filters metrics endpoints (/metrics)
# - Filters static assets (/studio/assets/*, /static/*, /fonts/*, /sounds/*)
# - Filters service worker files (/studio/sw.js, /studio/workbox-*.js)
# Useful for reducing noise during development while preserving full OTEL traces.
# Default: false (normal logging behavior)
QUIET_LOGS=false

# Traefik Gateway Logging (used by docker-compose.test.yml)
# When QUIET_LOGS=true is desired, also set these to reduce Traefik noise:
#   TRAEFIK_LOG_LEVEL=WARN
#   TRAEFIK_ACCESS_LOG=false
# Available levels: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ACCESS_LOG=true

# -----------------------------------------------------------------------------
# Observability Query Backends (LGTM Stack)
# -----------------------------------------------------------------------------
# Backend selection for observability query clients
# These must be set to use concrete implementations (not stubs) for the frontend
# Reference: src/mcp_server_langgraph/observability/query/factory.py
OBSERVABILITY_TRACING_BACKEND=tempo
OBSERVABILITY_LOGGING_BACKEND=loki
OBSERVABILITY_METRICS_BACKEND=mimir
OBSERVABILITY_ALERTING_BACKEND=grafana

# -----------------------------------------------------------------------------
# LGTM Stack URLs (Loki, Grafana, Tempo, Mimir)
# -----------------------------------------------------------------------------
# URLs for LGTM stack services - used by observability query clients
# External ports for local development (match docker-compose.test.yml)
LOKI_URL=http://localhost:13100
TEMPO_URL=http://localhost:13200
MIMIR_URL=http://localhost:19009
GRAFANA_URL=http://localhost:13001

# -----------------------------------------------------------------------------
# WebSocket Connection Limits
# -----------------------------------------------------------------------------
# Uses Settings defaults: 5 connections, 600 msg/min, 1800s idle, 1MB max

# -----------------------------------------------------------------------------
# Feature Flags (optional overrides from defaults)
# -----------------------------------------------------------------------------
# Uncomment to override default feature flag values:
# FF_ENABLE_DETAILED_LOGGING=true
# FF_ENABLE_OPENFGA=true
# FF_ENABLE_KEYCLOAK=true
#
# Canvas/Studio UI Feature Flags (Phased Rollout)
# FF_STUDIO_CANVAS_SHELL, FF_ENABLE_AI_SUGGESTIONS, FF_ENABLE_AI_SUGGESTIONS_WEBSOCKET,
# FF_ENABLE_ORCHESTRATOR_STATUS_WEBSOCKET default to True
# These override defaults (False -> True):
FF_CANVAS_EDITABLE=true          # Phase 2: Editable artifacts in Canvas panel
FF_CANVAS_AGENTS=true            # Phase 4: Background agent panel
FF_CANVAS_AI_PALETTE=true        # Phase 4: AI fallback in command palette
FF_CANVAS_COMPLIANCE=true        # Phase 5: Compliance dashboards
FF_CANVAS_HELP=true              # Phase 6: In-app help pane

# Experimental Features (enabled in test environment for full coverage)
FF_ENABLE_EXPERIMENTAL_FEATURES=true     # Master switch for experimental features
FF_ENABLE_MULTI_AGENT_COLLABORATION=true # Multi-agent coordination
FF_ENABLE_TOOL_REFLECTION=true           # Agent tool usage analysis
FF_ENABLE_BASH_TOOL=true                 # Enhanced bash tool for sandboxed command execution
FF_ENABLE_COMPUTER_USE=true              # Screen capture, input simulation, browser automation
# Native LLM Provider Tools (v7)
# Feature toggles only - config defaults in Settings are sufficient
FF_NATIVE_TOOLS_ENABLED=true             # Enable native tools (Anthropic, Google, OpenAI)
FF_ANTHROPIC_NATIVE_WEB_SEARCH_ENABLED=true  # Enable Anthropic native web search tool
FF_ANTHROPIC_NATIVE_CODE_EXECUTION_ENABLED=false  # Disabled: remote code execution
FF_GOOGLE_NATIVE_SEARCH_ENABLED=true     # Enable Google grounded search (googleSearch)
FF_OPENAI_NATIVE_WEB_SEARCH_ENABLED=true # Enable OpenAI web_search via Responses API
FF_OPENAI_NATIVE_CODE_INTERPRETER_ENABLED=false  # Disabled: remote code interpreter
FF_USE_RESPONSES_API_FOR_OPENAI=true     # Use LiteLLM Responses API for OpenAI native tools
# NOTE: Rate limits, timeouts, circuit breaker config use Settings defaults:
# - NATIVE_TOOL_RATE_LIMIT_ANTHROPIC=30, GOOGLE=60, OPENAI=60 (rpm)
# - NATIVE_TOOL_TIMEOUT_SECONDS=30, CIRCUIT_BREAKER_THRESHOLD=5, RESET_SECONDS=60
FF_ENABLE_SESSION_FORK=true              # Session fork capability for branching conversation history

# ADR-0072 Anthropic Best Practices Features
# FF_ENABLE_TOOL_EXAMPLES and FF_ENABLE_THINK_TOOL default to True
# These override defaults (False -> True):
FF_ENABLE_DEFER_LOADING=true             # Defer loading for token efficiency
FF_ENABLE_PROGRAMMATIC_TOOLS=true        # Programmatic tool calling from sandbox
FF_ENABLE_MULTI_AGENT_ORCHESTRATION=true # Orchestrator-worker pattern
FF_ENABLE_AGENTIC_MEMORY=true            # NOTES.md structured note-taking
FF_ENABLE_SDK_CAN_USE_TOOL=true          # Dynamic tool permission checks

# Plan Editor Features (Phase 5b - Prompt Architecture ADR-0089)
FF_ENABLE_PLAN_SEARCH=true               # Semantic template search using vector embeddings
FF_ENABLE_PLAN_TEMPLATES=true            # Template suggestion features for execution plans

# Chat-to-Workflow Feature (Plan: greedy-wiggling-marshmallow.md)
FF_ENABLE_WORKFLOW_FROM_CHAT=true        # Generate workflows from chat sessions with versioning

# Agent Orchestration Architecture (ADR Plan Phases 3-5)
# These flags control the phased rollout of RouterAgent, SwarmOrchestrator,
# and hierarchical orchestration patterns.
FF_ENABLE_ROUTER_AGENT=true              # Phase 3: Enable RouterAgent for task classification
FF_ENABLE_SWARM_ORCHESTRATOR=true        # Phase 4: Enable SwarmOrchestrator (race/cascade/consensus)
FF_ENABLE_HIERARCHICAL_ORCHESTRATOR=true # Phase 4: Enable hierarchical coordinator-worker pattern
# force_high_risk_review, critique_cross_vendor, critique_streaming,
# enable_plan_cache, orchestration_compat_mode default to True
# These override defaults:
FF_DEFAULT_CRITIQUE_ROUNDS=1             # Default critique rounds (0-3)
FF_ENABLE_CRITIQUE_LOOP=true             # Enable multi-pass executor+critic loop (default False)
EXECUTOR_MODEL_NAME=vertex_ai/gemini-3-flash-preview
CRITIC_MODEL_NAME=vertex_ai/claude-sonnet-4-5@20250929
FF_MAX_CRITIQUE_ROUNDS=3                 # Maximum critique iterations (hard cap)
FF_ORCHESTRATION_COMPAT_MODE=false       # Disable compat mode (default True)
FF_MAX_THINKING_BUDGET=medium            # Cap thinking budget
FF_ROUTER_CACHE_TTL_SECONDS=3600         # Router cache TTL (1 hour)
FF_ENABLE_ORCHESTRATOR_SELECTOR=true     # Frontend orchestrator selector (default False)

# Execution Mode Features (Plan Mode)
# execution_mode_toggle, bypass_mode_admin_only, preferences_menu_enabled default to True
# These override defaults (False -> True):
FF_ENABLE_PLAN_GENERATION=true           # Enable plan generation for audit trail
FF_ENABLE_PLAN_APPROVAL_FLOW=true        # Enable HITL approval for medium/high risk plans
FF_BYPASS_RISK_AWARE_ENABLED=true        # Auto-approve low-risk plans in bypass mode

# UI Enhancement Features
# Many of these default to True (interactive_artifacts, url_content_fetch, slash_commands,
# style_presets, command_palette, keyboard_shortcuts, ai_quality_metrics)
# These override defaults (False -> True):
FF_ENABLE_COST_DASHBOARD_USERS=true      # Cost dashboard visible to non-admin users

# StudioShell UX Features (Sprint 4-5)
# All these default to True: panel_zoom, mobile_drawer, onboarding_wizard,
# use_model_registry_for_frontend, enable_enhanced_model_selector

# AI UX Features (Phase 6 AI-Native Integration)
# Most default to True (ai_ux, ai_ux_websocket, ai_ux_streaming, llm_factory_streaming,
# ai_disclosure, ai_empty_states, ai_nudges, ai_error_recovery, ai_onboarding,
# ai_metrics_insights, ai_persona_analysis, insights_session_dismissal)
# These override defaults (False -> True):
FF_ENABLE_AI_UX_REDIS_CACHE=true         # Redis caching for AI UX LLM responses
FF_ENABLE_FRONTEND_REDIS_L2_CACHE=true   # Redis L2 cache for frontend
FF_ENABLE_LITELLM_MODEL_SYNC=true        # Sync model pricing from LiteLLM to ModelRegistry

# Shell Chat Input Features (Sprint 1 - Chat Input Gap Fix)
# NOTE: These are now ON by default - explicit settings kept for documentation
# FF_ENABLE_MODEL_SELECTOR_IN_SHELL=true  # Now default=True
# FF_ENABLE_URL_FETCH_IN_SHELL=true       # Now default=True

# Markdown Reference System (Plan: inherited-bouncing-church.md)
# NOTE: Now ON by default
# FF_ENABLE_MARKDOWN_REFERENCES=true      # Now default=True

# Source Citations (web search, KB references, Google grounding)
# NOTE: Now ON by default
# FF_ENABLE_SOURCE_CITATIONS=true         # Now default=True

# Connection Setup Features (ADR-0102 - Connections Page Redesign)
# NOTE: Now ON by default
# FF_ENABLE_CONNECTOR_SUGGESTIONS=true    # Now default=True

# Studio AI Orchestration (StudioShell AI Enhancement)
# All Studio AI features enabled for comprehensive testing
FF_ENABLE_STUDIO_AI=true                 # Master toggle for Studio AI orchestration
FF_ENABLE_SESSION_INTELLIGENCE=true      # Session summarize, group, similarity
# Session AI features (SessionNav AI-powered session cards)
FF_ENABLE_SESSION_AI=true                # Enable AI-powered session cards
FF_ENABLE_SESSION_SUMMARY=true           # Show AI-generated session summaries
FF_ENABLE_SESSION_TOPICS=true            # Show AI-extracted session topics
FF_ENABLE_CONVERSATION_INTELLIGENCE=true # Intent detection, context optimization, goal tracking
FF_ENABLE_CANVAS_INTELLIGENCE=true       # Artifact type suggestions, code analysis, diff explanation
FF_ENABLE_DIAGRAM_INTELLIGENCE=true      # Diagram analyze, convert to code
FF_ENABLE_TRACE_INTELLIGENCE=true        # Trace summarize, anomaly detection
FF_ENABLE_HITL_AI=true                   # Risk assessment, decision history
FF_ENABLE_GENUI=true                     # Generative UI (dynamic component rendering)

# Orchestrators (specialized AI agents)
FF_ENABLE_ORCHESTRATED_AI_UX=true        # UX Orchestrator for AI-powered UX features
FF_ENABLE_ORCHESTRATED_ALERT_ANALYSIS=true # Alert Orchestrator for intelligent alert analysis
FF_ENABLE_AI_EXPLANATIONS=true           # Explanation Orchestrator for AI-generated explanations
FF_ENABLE_LOOP_AGENT=true                # Loop Agent for iterative task execution
FF_ENABLE_AGENT_HITL=true                # HITL Orchestrator for human-in-the-loop workflows

# MCP Extensions (orchestration exposed as MCP resources/tools)
FF_ENABLE_ORCHESTRATION_MCP_RESOURCES=true  # Expose orchestration as MCP resources (orchestrator://*)
FF_ENABLE_ORCHESTRATION_MCP_TOOLS=true      # Expose orchestration operations as MCP tools
FF_ENABLE_HOOKS_MCP_EXTENSION=true          # Hooks MCP tool for listing registered hooks

# ADR-0092 Hierarchical Capability Architecture (Phase 1-6 Complete)
# These flags control the phased rollout of capability-aware agent execution.
# All enabled for testing to verify full capability flow.
# See: docs/architecture/adr-0092-hierarchical-capability-architecture.mdx
FF_ENABLE_HIERARCHICAL_CAPABILITY_PROVIDER=true  # Master toggle for ADR-0092 architecture
FF_ENABLE_ENHANCED_ROUTER_OUTPUT=true    # P0: RouterOutput with skills_needed, execution_mode
FF_ENABLE_CAPABILITY_RESOLUTION=true     # P1: Master for hierarchical registries + providers
FF_ENABLE_STUDIO_MD_LOADING=true         # P1: STUDIO.md discovery, parsing, and storage
FF_ENABLE_MULTI_PATTERN_EXECUTION=true   # P1: ReACT, programmatic, orchestrator execution modes
FF_ENABLE_USER_CAPABILITY_SELECTION=true # P2: UI tool/skill selectors in chat
FF_ENABLE_PROGRESSIVE_SKILL_LOADING=true # P2: 4-stage progressive skill loading
# ADR-0092/0099: Semantic search flags moved to ADR-0099 section below
FF_ENABLE_HITL_UNDO_ROLLBACK=true        # P3: Reversible actions with undo support

# ADR-0099 Semantic Search for Tools, Skills, and Memories
# Settings defaults: MAX_SELECTED_TOOLS=10, MAX_SELECTED_SKILLS=5, MAX_RETRIEVED_MEMORIES=10, THRESHOLD=0.5
# NOTE: These are now ON by default - explicit settings kept for documentation
# FF_ENABLE_SEMANTIC_TOOL_SEARCH=true      # Now default=True
# FF_ENABLE_SEMANTIC_SKILL_SEARCH=true     # Now default=True
# FF_ENABLE_SEMANTIC_MEMORY_SEARCH=true    # Now default=True

# Semantic Search Audit Feature Flags (ADR-0094/0095)
# These flags control the phased rollout of audit findings fixes.
# See: docs-internal/audits/SEMANTIC_SEARCH_AUDIT_COMPLETION_2026-01-06.md
FF_ENABLE_MULTI_TENANT_ISOLATION=true    # Phase 2.2: Security-critical tenant isolation in vector search
FF_ENABLE_PROGRESSIVE_CONTEXT_DISCOVERY=true  # Phase 3.2: Iterative semantic search for complex queries
FF_ENABLE_KB_FOCUS=true                  # ADR-0094: Perplexity-style KB focus mode

# Context Intelligence Features
# NOTE: These are now ON by default - explicit settings kept for documentation
# FF_ENABLE_CONTEXT_GRAPH=true             # Now default=True
# FF_ENABLE_PRECEDENT_SEARCH=true          # Now default=True

# -----------------------------------------------------------------------------
# Authorization (OpenFGA)
# -----------------------------------------------------------------------------
# OpenFGA is ENABLED for proper E2E auth testing
# Set ENABLE_MOCK_AUTHORIZATION=true only for unit tests that don't need real auth
ENABLE_MOCK_AUTHORIZATION=false
# Disable fallback to require real OpenFGA for E2E tests
ALLOW_AUTH_FALLBACK=false
# enable_openfga and enable_keycloak default to True
# OpenFGA Advanced Features (ADR-0068 Phases 3 & 6)
# These override defaults (False -> True):
FF_OPENFGA_STRICT_MODE=true              # Fail-closed on OpenFGA errors
FF_OPENFGA_ORG_CONTEXT_ENFORCEMENT=true  # Require org context in checks
FF_OPENFGA_CONDITIONS_ENABLED=true       # Enable condition evaluation
# OIDC authentication for OpenFGA API (OpenID Connect) - ACTIVE
# OpenFGA server validates OIDC tokens (OPENFGA_AUTHN_METHOD=oidc)
# Applications obtain access tokens from Keycloak via client credentials grant
# Defense-in-depth security: network isolation + token validation
OPENFGA_OIDC_CLIENT_ID=agent-studio-openfga-oidc-cient-id-for-e2e-tests
OPENFGA_OIDC_CLIENT_SECRET=agent-studio-openfga-oidc-client-secret-for-e2e-tests
# Store name for dynamic lookup (store_id is resolved at runtime)
# This matches the store name created by openfga-seed-test container
OPENFGA_STORE_NAME=agent-studio-openfga-store-test

# -----------------------------------------------------------------------------
# WebSocket Infrastructure (ADR-0068)
# -----------------------------------------------------------------------------
# websocket_new_base, websocket_server_heartbeat, websocket_enhanced_metrics,
# agent_hitl_push_notifications, agent_hitl_websocket default to True

# -----------------------------------------------------------------------------
# DevTools AI Features
# -----------------------------------------------------------------------------
# NOTE: FF_DEVTOOLS_AI_INSIGHTS is now ON by default
# FF_DEVTOOLS_AI_INSIGHTS=true             # Now default=True
FF_DEVTOOLS_AI_LAYOUT=true                 # AI-powered layout suggestions (still default=False)

# -----------------------------------------------------------------------------
# Claude Agent SDK Features (ADR-0077)
# -----------------------------------------------------------------------------
# sdk_hooks and sdk_interrupt default to True
# This overrides default (False -> True):
FF_ENABLE_SDK_FILE_CHECKPOINTING=true      # File rollback capability

# -----------------------------------------------------------------------------
# AI UX Advanced Features
# -----------------------------------------------------------------------------
# ai_ux_parallel_graph and suggestion_quality_tracking default to True
# These override defaults (False -> True):
FF_ENABLE_DISTRIBUTED_RATE_LIMITING=true   # Redis-backed distributed rate limiting
FF_ENABLE_SUGGESTION_PREWARM=true          # Pre-compute common suggestions

# -----------------------------------------------------------------------------
# Rich UI Features
# -----------------------------------------------------------------------------
# rich_text_chat_input defaults to True
# NOTE: FF_ENABLE_MANUAL_TOOL_SELECTION is now ON by default
# FF_ENABLE_MANUAL_TOOL_SELECTION=true     # Now default=True

# Message Rendering Consolidation (ADR-0104)
FF_UNIFIED_MESSAGE_LIST=true              # Use UnifiedMessageList for consolidated message rendering

# -----------------------------------------------------------------------------
# Settings Migration Feature Flags
# -----------------------------------------------------------------------------
# These flags were migrated from Settings to FeatureFlags for proper FF semantics.
# They control feature enablement suitable for gradual rollout and kill switches.
# Verification
FF_VERIFICATION_ENABLED=true               # LLM-as-judge verification (default: true)
FF_VISUAL_VERIFICATION_ENABLED=true        # Screenshot verification (default: false)
# Context
FF_CHECKPOINTING_ENABLED=true              # Conversation checkpointing (default: true)
FF_CONTEXT_COMPACTION_ENABLED=true         # Context compaction (default: true)
FF_DYNAMIC_CONTEXT_LOADING_ENABLED=true    # Semantic context loading (default: false)
# Execution
FF_PARALLEL_TOOL_EXECUTION_ENABLED=true    # Parallel tool execution (default: false)
FF_CODE_EXECUTION_ENABLED=true             # Sandboxed code execution (default: false)
FF_SANDBOX_TOOLS_ENABLED=true              # Sandbox tools (default: false)
# Model
FF_DEDICATED_SUMMARIZATION_MODEL_ENABLED=true  # Dedicated summarization model (default: true)
FF_DEDICATED_VERIFICATION_MODEL_ENABLED=true   # Dedicated verification model (default: true)
FF_LLM_EXTRACTION_ENABLED=true             # LLM structured extraction (default: false)
# Streaming
FF_STREAMING_ENABLED=true                  # Global streaming support (default: true)
# Artifacts
FF_ARTIFACTS_SEMANTIC_SEARCH_ENABLED=true  # Vector search for artifacts (default: true)
FF_ARTIFACTS_CLOUD_STORAGE_ENABLED=false   # Cloud storage for artifacts (default: false)

# -----------------------------------------------------------------------------
# Security & Performance Testing Flags
# -----------------------------------------------------------------------------
# These flags enable features important for security and performance testing
# but are disabled by default in production for safety/cost reasons.
# Enable these when specifically testing these subsystems.
FF_ENABLE_ENCRYPTED_SESSIONS=false         # AES-256 session encryption (default: false)
FF_ENABLE_RESPONSE_CACHING=false           # LLM response caching (default: false)
FF_ENABLE_TRACE_SAMPLING=false             # Trace sampling for observability (default: false)

# -----------------------------------------------------------------------------
# Timeouts (Lower for faster test feedback)
# -----------------------------------------------------------------------------
MODEL_TIMEOUT=30                           # Default: 60s, faster test failures
KEYCLOAK_TIMEOUT=10                        # Default: 30s, faster test failures
PROMETHEUS_TIMEOUT=10                      # Default: 30s, faster test failures

# -----------------------------------------------------------------------------
# Agent Loop Limits (Prevent runaway tests)
# -----------------------------------------------------------------------------
MAX_ITERATIONS=5                           # Default: 10, test containment
MAX_REFINEMENT_ATTEMPTS=2                  # Default: 3, faster test cycles

# -----------------------------------------------------------------------------
# Session Limits (Test isolation)
# -----------------------------------------------------------------------------
SESSION_TTL_SECONDS=3600                   # Default: 86400 (24h), 1h for tests
SESSION_IDLE_SECONDS=300                   # Default: 1800 (30min), 5min for tests
SESSION_MAX_CONCURRENT=10                  # Default: 5, higher for parallel tests

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_FORMAT=json is the default

# -----------------------------------------------------------------------------
# Code Execution Advanced Config
# -----------------------------------------------------------------------------
# CODE_EXECUTION_TIMEOUT=30, MEMORY_LIMIT_MB=512, CPU_QUOTA=1.0 use defaults
# These override defaults:
CODE_EXECUTION_DOCKER_IMAGE=ghcr.io/vishnu2kmohan/mcp-server-langgraph-agent-studio-sandbox:latest
CODE_EXECUTION_NETWORK_MODE=unrestricted  # Overrides "none" for test flexibility

# -----------------------------------------------------------------------------
# OpenTelemetry Resource Attributes
# -----------------------------------------------------------------------------
OTEL_RESOURCE_ATTRIBUTES=service.namespace=agent-studio,deployment.environment=test

# -----------------------------------------------------------------------------
# Grafana API Authentication (for mcp-server observability queries)
# -----------------------------------------------------------------------------
# NOTE: In test environment without TLS, we use basic auth.
# UI login still uses Keycloak OAuth via GF_AUTH_GENERIC_OAUTH_ENABLED.
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin

# -----------------------------------------------------------------------------
# Keycloak Public URL (for browser redirects in OAuth2/PKCE flow)
# -----------------------------------------------------------------------------
KEYCLOAK_PUBLIC_URL=http://localhost/authn

# -----------------------------------------------------------------------------
# OpenFGA OIDC Configuration
# -----------------------------------------------------------------------------
# These values must match docker-compose.test.yml for proper OIDC token validation
OPENFGA_OIDC_ISSUER=http://localhost/authn/realms/default
OPENFGA_AUTHN_OIDC_AUDIENCE=agent-studio-openfga-oidc-cient-id-for-e2e-tests
