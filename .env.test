# =============================================================================
# Test Environment Configuration
# =============================================================================
# This file contains test environment defaults for `make test-infra-up`.
# It is checked into git and provides the source of truth for test config.
#
# Override locally with:
#   - .env.test.local (gitignored, personal overrides)
#   - Shell environment variables
#
# Docker networking values (container hostnames like redis-test, postgres-test)
# are set in docker-compose.test.yml environment: block as they require
# compose-level interpolation.
#
# 12-Factor Compliance:
#   - Config separated from code ✓
#   - Environment variables ✓
#   - No production secrets ✓ (test-only credentials)
#
# Synchronization:
#   Values here MUST match:
#   - docker-compose.test.yml environment: block
#   - tests/constants.py
#   - .github/workflows/e2e-tests.yaml env: section
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=test
TESTING=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# JWT Authentication (test-only secret, safe to commit)
# -----------------------------------------------------------------------------
# IMPORTANT: This MUST match docker-compose.test.yml and tests/constants.py
JWT_SECRET_KEY=test-jwt-secret-key-for-e2e-testing-only

# -----------------------------------------------------------------------------
# Conversation Checkpointing (Agent Memory)
# -----------------------------------------------------------------------------
# Enable Redis-backed checkpointing for conversation persistence
CHECKPOINT_BACKEND=redis
CHECKPOINT_REDIS_TTL=604800

# -----------------------------------------------------------------------------
# Database (test credentials, safe to commit)
# -----------------------------------------------------------------------------
# PostgreSQL connection - host set in docker-compose.test.yml (postgres-test)
POSTGRES_PORT=5432
POSTGRES_DB=mcp_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Use Keycloak for unified AuthN (users seeded via realm import)
AUTH_PROVIDER=keycloak
KEYCLOAK_REALM=default
KEYCLOAK_CLIENT_ID=mcp-server
KEYCLOAK_CLIENT_SECRET=test-client-secret-for-e2e-tests
# Admin API access (must use master realm for admin-cli client)
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Frontend URL for OAuth2 callback redirects
# In Docker/Traefik environments, use gateway URL (http://localhost)
# In local development, use Vite dev server (http://localhost:5173)
FRONTEND_URL=http://localhost

# -----------------------------------------------------------------------------
# OAuth2 (MCP Connections)
# -----------------------------------------------------------------------------
# Redirect URI for OAuth2-authenticated MCP server connections
# Must match Keycloak client redirectUris in tests/e2e/default-realm.json
OAUTH2_REDIRECT_URI=http://localhost/studio/oauth/callback

# -----------------------------------------------------------------------------
# LLM Provider - Vertex AI (GCP Project: vishnu-sandbox-20250310)
# -----------------------------------------------------------------------------
# Uses Vertex AI for Gemini and Claude models
# Authentication: gcloud auth application-default login (or service account)
LLM_PROVIDER=vertex_ai
MODEL_NAME=vertex_ai/gemini-3-pro-preview
VERTEXAI_LOCATION=global
GOOGLE_CLOUD_LOCATION=global

# -----------------------------------------------------------------------------
# Cost Metrics Storage (Phase 2.2 SRP decomposition)
# -----------------------------------------------------------------------------
# Uses PostgresCostStorage for cost tracking persistence
COST_STORAGE_BACKEND=postgres

# -----------------------------------------------------------------------------
# Workflow Storage (Unified Workspace Paradigm)
# -----------------------------------------------------------------------------
# Uses PostgresWorkflowManager for workflow definitions and sharing
WORKFLOW_STORAGE_BACKEND=postgres

# -----------------------------------------------------------------------------
# Vector Database (Qdrant)
# -----------------------------------------------------------------------------
# Qdrant URL for vector storage - host set in docker-compose.test.yml (qdrant-test)
# Default port matches docker-compose.test.yml mapped port (9333:6333)
QDRANT_URL=http://localhost:9333
QDRANT_COLLECTION_NAME=mcp_context
QDRANT_VECTOR_SIZE=384

# -----------------------------------------------------------------------------
# GDPR/Compliance
# -----------------------------------------------------------------------------
GDPR_STORAGE_BACKEND=postgres

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=mcp-server-test
# Disable console span/metric export to reduce log noise (send to OTLP only)
# Spans are sent to Alloy via OTEL_EXPORTER_OTLP_ENDPOINT, not stdout
ENABLE_CONSOLE_EXPORT=false

# -----------------------------------------------------------------------------
# Observability Query Backends (LGTM Stack)
# -----------------------------------------------------------------------------
# Backend selection for observability query clients
# These must be set to use concrete implementations (not stubs) for the frontend
# Reference: src/mcp_server_langgraph/observability/query/factory.py
OBSERVABILITY_TRACING_BACKEND=tempo
OBSERVABILITY_LOGGING_BACKEND=loki
OBSERVABILITY_METRICS_BACKEND=prometheus
OBSERVABILITY_ALERTING_BACKEND=grafana

# -----------------------------------------------------------------------------
# LGTM Stack URLs (Loki, Grafana, Tempo, Mimir)
# -----------------------------------------------------------------------------
# URLs for LGTM stack services - used by observability query clients
# External ports for local development (match docker-compose.test.yml)
LOKI_URL=http://localhost:13100
TEMPO_URL=http://localhost:13200
MIMIR_URL=http://localhost:19009
GRAFANA_URL=http://localhost:13001

# -----------------------------------------------------------------------------
# Feature Flags (optional overrides from defaults)
# -----------------------------------------------------------------------------
# Uncomment to override default feature flag values:
# FF_ENABLE_DETAILED_LOGGING=true
# FF_ENABLE_OPENFGA=true
# FF_ENABLE_KEYCLOAK=true

# -----------------------------------------------------------------------------
# Authorization (OpenFGA)
# -----------------------------------------------------------------------------
# OpenFGA is ENABLED for proper E2E auth testing
# Set ENABLE_MOCK_AUTHORIZATION=true only for unit tests that don't need real auth
ENABLE_MOCK_AUTHORIZATION=false
# Disable fallback to require real OpenFGA for E2E tests
ALLOW_AUTH_FALLBACK=false
# Enable OpenFGA feature flag
FF_ENABLE_OPENFGA=true
# Enable Keycloak feature flag
FF_ENABLE_KEYCLOAK=true
# OIDC authentication for OpenFGA API (OpenID Connect) - ACTIVE
# OpenFGA server validates OIDC tokens (OPENFGA_AUTHN_METHOD=oidc)
# Applications obtain access tokens from Keycloak via client credentials grant
# Defense-in-depth security: network isolation + token validation
OPENFGA_OIDC_CLIENT_ID=openfga-server
OPENFGA_OIDC_CLIENT_SECRET=test-openfga-server-secret
# Store name for dynamic lookup (store_id is resolved at runtime)
# This matches the store name created by openfga-seed-test container
OPENFGA_STORE_NAME=mcp-server-langgraph-test
