  ],
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "Offline access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "UMA authorization",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "user",
        "description": "Standard user role for tool access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "premium",
        "description": "Premium user role with enhanced access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Administrator role with full access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "developer",
        "description": "Developer role with access to build and workflow features",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": true,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "IMPORT",
        "clientId": "placeholder-github-client-id",
        "clientSecret": "placeholder-github-client-secret",
        "defaultScope": "user:email read:user",
        "hideOnLoginPage": "false"
      }
    },
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "IMPORT",
        "clientId": "placeholder-google-client-id",
        "clientSecret": "placeholder-google-client-secret",
        "defaultScope": "openid email profile",
        "hideOnLoginPage": "false"
      }
    },
    {
      "alias": "microsoft",
      "displayName": "Microsoft",
      "providerId": "microsoft",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "IMPORT",
        "clientId": "placeholder-microsoft-client-id",
        "clientSecret": "placeholder-microsoft-client-secret",
        "defaultScope": "openid email profile",
        "hideOnLoginPage": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "github-username-mapper",
      "identityProviderAlias": "github",
      "identityProviderMapper": "github-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "jsonField": "login",
        "userAttribute": "username"
      }
    },
    {
      "name": "github-email-mapper",
      "identityProviderAlias": "github",
      "identityProviderMapper": "github-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "jsonField": "email",
        "userAttribute": "email"
      }
    },
    {
      "name": "google-email-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "google-name-mapper",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "microsoft-email-mapper",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "microsoft-name-mapper",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "name",
        "user.attribute": "firstName"
      }
    }
  ],
  "defaultRoles": [
    "offline_access",
    "uma_authorization",
    "user"
  ],
  "requiredCredentials": [
    "password"
  ],
  "passwordPolicy": "hashAlgorithm(pbkdf2-sha512)",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "eventsEnabled": false,
  "adminEventsEnabled": false,
  "adminEventsDetailsEnabled": false,
  "internationalizationEnabled": false
